# ============================
# DOMAIN APLIKASI (untuk fitur subdomain Exclusive)
# Isi dengan domain utama tanpa http:// — contoh: nikahyuk.com
# Vercel: tambahkan wildcard *.nikahyuk.com di Settings → Domains
# ============================
NEXT_PUBLIC_APP_DOMAIN="nikahyuk.com"

# ============================
# DATABASE (Supabase Pooler)
# Ambil dari: Supabase Dashboard → Settings → Database → Connection Pooling → URI
# Gunakan Transaction Pooler (port 6543), BUKAN Direct Connection (port 5432)
# ============================
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Untuk prisma migrate/push dari local (pakai Direct Connection port 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# ============================
# NEXTAUTH
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://your-app.vercel.app"

# ============================
# GOOGLE OAUTH (opsional)
# https://console.cloud.google.com → Credentials → OAuth 2.0
# ============================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================
# MIDTRANS
# https://dashboard.sandbox.midtrans.com → Settings → Access Keys
# ============================
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false

# ============================
# CLOUDINARY (upload foto)
# https://cloudinary.com → Dashboard → API Keys
# ============================
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================
# EMAIL (opsional)
# ============================
RESEND_API_KEY=""

# ============================
# GOOGLE reCAPTCHA v3
# https://www.google.com/recaptcha/admin/create
# Pilih reCAPTCHA v3, domain: ratnaoffset.com + localhost
# ============================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ============================
# GOOGLE MAPS EMBED
# https://console.cloud.google.com → APIs & Services → Credentials → Create API Key
# Aktifkan: Maps Embed API
# Batasi ke domain: ratnaoffset.com (HTTP referrers)
# ============================
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=""
